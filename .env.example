# PostgreSQL / Supabase
# Use the pooled connection string for the running app and the direct connection string for migrations when needed.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Server
PORT=5000
NODE_ENV=development

# Optional newsletter integration
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional public site URL used in newsletter links
SITE_URL=http://localhost:5000
