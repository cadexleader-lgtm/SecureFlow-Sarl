{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/spa.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/1",
      "destination": "/blog/chambre-commerce-chine-apporteur-affaires",
      "permanent": true
    },
    {
      "source": "/blog/2",
      "destination": "/blog/partenariat-petrolier-dubai",
      "permanent": true
    },
    {
      "source": "/blog/3",
      "destination": "/blog/infrastructures-minieres-securite-operationnelle",
      "permanent": true
    },
    {
      "source": "/blog/4",
      "destination": "/blog/reseau-europeen-paris",
      "permanent": true
    },
    {
      "source": "/blog/5",
      "destination": "/blog/pourquoi-securiser-commerce-international",
      "permanent": true
    },
    {
      "source": "/blog/6",
      "destination": "/blog/securiser-echanges-afrique-ouest-port-cotonou",
      "permanent": true
    },
    {
      "source": "/blog/7",
      "destination": "/blog/partenariat-exim-finance",
      "permanent": true
    },
    {
      "source": "/blog/8",
      "destination": "/blog/securiser-export-agricole",
      "permanent": true
    },
    {
